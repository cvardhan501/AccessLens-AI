# AccessLens AI Environment Configuration
# Copy this file to .env in this directory. Never commit .env with real secrets.

# --- Strands Decider 2B (Hosted or Local) ---
DECIDER_MODE=ugmdu                     # ugmdu (hosted) | local | custom
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY=                       # Set your key from AWS User Group Madurai

# --- Amazon Bedrock ---
LLM_PROVIDER=disabled                  # disabled by default; set to 'bedrock' to enable optional Bedrock explanations
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_SMALL_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_MEDIUM_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_LARGE_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Decision Thresholds ---
DECIDER_CONFIDENCE_THRESHOLD=0.70
